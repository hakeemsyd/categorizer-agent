# Copy to .env and fill in. Never commit the filled-in file.
# Every setting is read with the BOOKS_ prefix (see src/books/config.py).

# --- Core service ---
BOOKS_ENV=local
BOOKS_LOG_LEVEL=INFO
# Shared bearer token that every face (CLI, MCP, future Slack bot) presents
# to the FastAPI core. Generate: openssl rand -hex 32
BOOKS_API_TOKEN=change-me
# Where the faces find the core service.
BOOKS_API_BASE_URL=http://localhost:8000

# --- Database (Supabase Postgres) ---
# Use the *session pooler* / direct connection string, with +asyncpg.
BOOKS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/books

# --- Celery broker/result backend ---
BOOKS_REDIS_URL=redis://localhost:6379/0

# --- Secrets at rest ---
# Fernet key encrypting provider access tokens before they touch Postgres.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BOOKS_ENCRYPTION_KEY=

# --- Provider (Teller: https://teller.io/docs) ---
BOOKS_DEFAULT_PROVIDER=teller
# Public value from the Teller Dashboard — Connect embeds it client-side.
BOOKS_TELLER_APPLICATION_ID=
# sandbox needs no certificate at all. development/production need one
# issued by Teller for this application (mutual TLS authenticates every call).
BOOKS_TELLER_ENVIRONMENT=sandbox
BOOKS_TELLER_CERT_PATH=
BOOKS_TELLER_KEY_PATH=
# HMAC secret from the Teller Dashboard, for verifying webhook signatures.
# Register https://<your-tunnel>/webhooks/teller there (ngrok in dev).
BOOKS_TELLER_SIGNING_SECRET=

# --- Categorization agent ---
BOOKS_ANTHROPIC_API_KEY=
# Only needed if the key above is organization-level rather than scoped to a
# workspace — Anthropic otherwise rejects requests with "not scoped to a
# workspace". A workspace-scoped key needs this left blank.
BOOKS_ANTHROPIC_WORKSPACE_ID=
BOOKS_CATEGORIZER_MODEL=claude-sonnet-5
BOOKS_CONFIDENCE_THRESHOLD=0.80
BOOKS_SIMILAR_TRANSACTION_LIMIT=15
