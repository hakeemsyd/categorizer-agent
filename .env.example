# Copy to .env and fill in. Never commit the filled-in file.
# Every setting is read with the BOOKS_ prefix (see src/books/config.py).

# --- Core service ---
BOOKS_ENV=local
BOOKS_LOG_LEVEL=INFO
# Shared bearer token that every face (CLI, MCP, future Slack bot) presents
# to the FastAPI core. Generate: openssl rand -hex 32
BOOKS_API_TOKEN=change-me
# Where the faces find the core service.
BOOKS_API_BASE_URL=http://localhost:8000

# --- Database (Supabase Postgres) ---
# Use the *session pooler* / direct connection string, with +asyncpg.
BOOKS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/books

# --- Celery broker/result backend ---
BOOKS_REDIS_URL=redis://localhost:6379/0

# --- Secrets at rest ---
# Fernet key encrypting provider access tokens before they touch Postgres.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BOOKS_ENCRYPTION_KEY=

# --- Provider (Fintable: https://fintable.io/docs) ---
BOOKS_DEFAULT_PROVIDER=fintable

# Fintable OAuth 2.0 (PKCE). Register an app at fintable.io and paste its
# client id. There is NO client secret — Fintable is a public client and the
# docs are explicit that one is never generated, shown, or accepted.
BOOKS_FINTABLE_CLIENT_ID=
BOOKS_FINTABLE_BASE_URL=https://fintable.io
# Must match a redirect URI registered on the app. Loopback gets RFC 8252
# treatment: any runtime port is accepted, so registering
# http://127.0.0.1/oauth/callback covers this. The PATH still has to match,
# and "localhost" is rejected — use the literal 127.0.0.1.
BOOKS_FINTABLE_REDIRECT_URI=http://127.0.0.1:8420/oauth/callback
# `read` is enough to pull accounts and transactions. `write` would also let
# the agent modify data inside Fintable, which this app never does.
BOOKS_FINTABLE_SCOPES=read
# Pagination cursors are bound to one workspace. Leave blank to use the
# token's default, resolved once from /api/v2/me.
BOOKS_FINTABLE_WORKSPACE_ID=

# --- Categorization agent ---
# qwen (default) or anthropic. Set BOOKS_CATEGORIZER_MODEL to match — a model
# name for one provider means nothing to the other.
BOOKS_LLM_PROVIDER=qwen

# Qwen via Alibaba Cloud Model Studio (DashScope), OpenAI-compatible.
BOOKS_QWEN_API_KEY=
# Singapore by default. Beijing is:
#   https://dashscope.aliyuncs.com/compatible-mode/v1
# The key and the URL are region-scoped together — a key from one region
# against the other region's URL fails as if the key were invalid.
# openai (DashScope) or anthropic (a MaaS endpoint serving /v1/messages).
# Must match the URL below, or calls 404 against the wrong path.
BOOKS_QWEN_API_STYLE=openai
BOOKS_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Only read when BOOKS_LLM_PROVIDER=anthropic.
BOOKS_ANTHROPIC_API_KEY=
# Only needed if the key above is organization-level rather than scoped to a
# workspace — Anthropic otherwise rejects requests with "not scoped to a
# workspace". A workspace-scoped key needs this left blank.
BOOKS_ANTHROPIC_WORKSPACE_ID=

# qwen-plus / qwen-max / qwen3-max for Qwen; claude-sonnet-5 for Anthropic.
BOOKS_CATEGORIZER_MODEL=qwen-plus
BOOKS_CONFIDENCE_THRESHOLD=0.80
BOOKS_SIMILAR_TRANSACTION_LIMIT=15
